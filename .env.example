# Copy to .env (never commit .env). server.py loads it on start.

# OpenAI API key: needed for Gmail scanning, the digest and the assistant.
OPENAI_API_KEY=
# Optional: which OpenAI model to use (default gpt-5.5).
# OPENAI_MODEL=gpt-5.5

# Google OAuth client (Web application) for "Continue with Google" and Gmail.
# Authorised redirect URI: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: outgoing email for password reset links (any SMTP server, e.g.
# Gmail with an app password: smtp.gmail.com, port 587). Without SMTP_HOST,
# reset links are printed in the server terminal instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=Squirrel <you@gmail.com>

# Optional: where the app is served (default http://127.0.0.1:8000).
# APP_URL=http://127.0.0.1:8000
